modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
# Autoscale (Cloud Run) only guarantees CPU during HTTP requests and can OOM
# in-process FFmpeg. This app must stay on a Reserved VM that never sleeps.
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["patchelf"]
